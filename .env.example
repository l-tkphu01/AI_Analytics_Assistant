# ═══ LLM API Keys ═══
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ═══ Data Source (fabric / postgresql / sqlite) ═══
# Để "sqlite" cho giai đoạn phát triển ban đầu
DATA_SOURCE=sqlite

# ═══ Microsoft Fabric ═══
FABRIC_SQL_ENDPOINT=your_workspace.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=your_warehouse_name
FABRIC_CLIENT_ID=your_service_principal_client_id
FABRIC_CLIENT_SECRET=your_service_principal_secret

# ═══ PostgreSQL / Supabase (fallback) ═══
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ═══ Security ═══
JWT_SECRET_KEY=your_random_secret_key_12345
JWT_ALGORITHM=HS256

# ═══ App Config ═══
CACHE_TTL=300
MAX_QUERY_ROWS=50000
QUERY_TIMEOUT=30
LOG_LEVEL=INFO